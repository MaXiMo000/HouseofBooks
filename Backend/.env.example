# Copy to Backend/.env and fill in. Backend/.env is gitignored -- it was
# committed five times before this repo had a .gitignore, and the Atlas URI it
# carried had to be rotated.
PORT=4001
MongoDBURI="mongodb+srv://<user>:<password>@<cluster>/<db>"

# Required. The server refuses to start without it.
JWT_SECRET=

# Comma-separated list of origins allowed to call this API.
FRONTEND_URL=http://localhost:5173
